# Configure these as backend secrets; never place real values in the Mac app.
BAIDU_APP_KEY=YOUR_BAIDU_APP_KEY
BAIDU_SECRET_KEY=YOUR_BAIDU_SECRET_KEY
BAIDU_APP_ROOT=/apps/YOUR_REGISTERED_APP_NAME
# Generate a unique 32-byte encryption key: openssl rand -hex 32
BAIDU_TOKEN_ENCRYPTION_KEY=YOUR_64_HEX_CHARACTER_KEY
# Hosted Supabase automatically provides SUPABASE_URL, SUPABASE_ANON_KEY,
# and SUPABASE_SERVICE_ROLE_KEY. The service-role key is backend-only.
